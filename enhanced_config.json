{
    "detection": {
        "model": "yolo11n.pt",
        "confidence": 0.25,
        "iou": 0.45
    },
    "tracking": {
        "max_age": 30,
        "min_hits": 3,
        "iou_threshold": 0.3
    },
    "segmentation": {
        "enabled": false,
        "model": "unet",
        "encoder": "resnet34"
